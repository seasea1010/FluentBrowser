<?xml version="1.0" encoding="utf-8"?>
<!-- CEF (see scripts/fetch-cef.ps1). CEF_ROOT is set by fetch-cef.ps1 via CefRoot.txt,
     or override: msbuild /p:CefRoot=<path>. Default layout: third_party\cef\current -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <CefRoot Condition="'$(CefRoot)'==''">$(SolutionDir)third_party\cef\current</CefRoot>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(CefRoot);$(CefRoot)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>USING_CEF_SHARED;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(CefRoot)\$(Configuration);$(CefRoot)\build\libcef_dll_wrapper\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>libcef.lib;libcef_dll_wrapper.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
