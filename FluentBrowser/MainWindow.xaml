<Window
    x:Class="FluentBrowser.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Closed="OnWindowClosed">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Loaded="OnWindowLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar (drag region set in code via AppWindow.TitleBar / SetTitleBar) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <TextBlock Text="FluentBrowser" VerticalAlignment="Center" Margin="12,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8"/>
        </Grid>

        <TabView x:Name="BrowserTabs" Grid.Row="1" VerticalAlignment="Top"
                 AddTabButtonClick="AddTab_Click" SelectionChanged="Tabs_SelectionChanged"
                 TabCloseRequested="Tabs_TabCloseRequested" CanDragTabs="False" CanReorderTabs="True"/>

        <!-- Toolbar: real Fluent AppBarButtons + rounded address box -->
        <Grid Grid.Row="2" Padding="6,4,6,4" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <AppBarButton x:Name="BackBtn" Grid.Column="0" Icon="Back" Label="戻る" Click="Back_Click" Width="48"/>
            <AppBarButton x:Name="ForwardBtn" Grid.Column="1" Icon="Forward" Label="進む" Click="Forward_Click" Width="48"/>
            <AppBarButton x:Name="ReloadBtn" Grid.Column="2" Icon="Refresh" Label="更新" Click="Reload_Click" Width="48"/>
            <AppBarButton Grid.Column="3" Icon="Home" Label="ホーム" Click="Home_Click" Width="48"/>
            <TextBox x:Name="AddressBox" Grid.Column="4" VerticalAlignment="Center"
                     PlaceholderText="検索または Web アドレスを入力" CornerRadius="16"
                     KeyDown="AddressBox_KeyDown"/>
            <Button x:Name="FavBtn" Grid.Column="5" VerticalAlignment="Center" Click="Favorite_Click"
                    ToolTipService.ToolTip="お気に入り" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE734;" FontSize="16"/>
            </Button>
            <AppBarButton Grid.Column="6" Icon="Download" Label="ダウンロード" Width="48">
                <AppBarButton.Flyout>
                    <Flyout><StackPanel Width="340" Spacing="8">
                        <TextBlock Text="ダウンロード" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <ListView x:Name="DownloadsList" MaxHeight="300"/>
                    </StackPanel></Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Grid.Column="7" Icon="Clock" Label="履歴" Width="48">
                <AppBarButton.Flyout>
                    <Flyout><StackPanel Width="340" Spacing="8">
                        <TextBlock Text="履歴" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <ListView x:Name="HistoryList" MaxHeight="300" SelectionChanged="HistoryList_SelectionChanged"/>
                    </StackPanel></Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Grid.Column="8" Icon="List" Label="お気に入り" Width="48">
                <AppBarButton.Flyout>
                    <Flyout><StackPanel Width="340" Spacing="8">
                        <TextBlock Text="お気に入り" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <ListView x:Name="BookmarksList" MaxHeight="300" SelectionChanged="BookmarksList_SelectionChanged"/>
                    </StackPanel></Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Grid.Column="9" Icon="More" Label="メニュー" Width="48">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="新しいタブ" Click="NewTabMenu_Click"/>
                        <MenuFlyoutItem Text="ページ内検索" Click="FindMenu_Click"/>
                        <MenuFlyoutItem Text="開発者ツール (F12)" Click="DevToolsMenu_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="設定" Click="SettingsMenu_Click"/>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </Grid>

        <!-- Find bar -->
        <Grid x:Name="FindBar" Grid.Row="3" Padding="6,2,6,2" ColumnSpacing="4" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FindBox" Grid.Column="0" PlaceholderText="ページ内検索" KeyDown="FindBox_KeyDown"/>
            <Button Grid.Column="1" Content="前へ" Click="FindPrev_Click"/>
            <Button Grid.Column="2" Content="次へ" Click="FindNext_Click"/>
            <Button Grid.Column="3" Content="閉じる" Click="FindClose_Click"/>
        </Grid>

        <!-- CEF child HWNDs are positioned over this placeholder (airspace: see CefHost.h) -->
        <Border x:Name="BrowserHostGrid" Grid.Row="4" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                SizeChanged="OnHostSizeChanged"/>

        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="8,2,8,4" Opacity="0.7"
                   Style="{StaticResource CaptionTextBlockStyle}" Text="準備完了"/>
    </Grid>
</Window>
